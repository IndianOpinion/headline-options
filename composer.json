{
    "name": "indianopinion/headline-options",
    "description": "WordPress plugin that asks a model for several headline candidates on a click, scores them with plain rules, and shows them in the editor. Never replaces a headline on its own.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "headlines",
        "editor",
        "llm",
        "newsroom"
    ],
    "homepage": "https://github.com/IndianOpinion/headline-options",
    "support": {
        "issues": "https://github.com/IndianOpinion/headline-options/issues",
        "source": "https://github.com/IndianOpinion/headline-options",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org",
            "homepage": "https://indianopinion.org"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/llm-json-php"
        },
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/script-share"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "indianopinion/llm-json-php": "^0.1"
    },
    "require-dev": {
        "indianopinion/script-share": "^0.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^3.10",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10"
    },
    "suggest": {
        "ext-intl": "Grapheme-cluster length and NFC normalisation. Without it, length is code points less combining marks and format characters.",
        "indianopinion/script-share": "Enables the script-match rule. Install it as its own package; it is never bundled."
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\HeadlineOptions\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\HeadlineOptions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable"
}
